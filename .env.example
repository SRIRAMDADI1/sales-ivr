# Copy to .env and fill in (sales-ivr/.env is gitignored).
# After that you never need PowerShell $env:... for these.
#
# Both values must belong to the SAME Azure resource that owns the deployment named in
# config.yaml -> llm.deployment. A key/endpoint from a different resource returns
# 404 DeploymentNotFound even when Foundry shows the deployment as Succeeded.
# Use the resource root only, not the full target URI from the Foundry deployment page.

AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
