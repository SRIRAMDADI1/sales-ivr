{
  "annotations": { "list": [] },
  "description": "Cost, tokens, and latency for Firstpass quote agents. Counters reset when a web pod restarts. Per-call rows stay in the on-site Pulse panel.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "decimals": 4, "unit": "currencyUSD" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum(llm_cost_usd_total)", "refId": "A" }],
      "title": "Estimated cost",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum(llm_calls_total)", "refId": "A" }],
      "title": "LLM calls",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum(llm_tokens_total)", "refId": "A" }],
      "title": "Tokens",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(llm_latency_ms_bucket[5m])))",
          "refId": "A"
        }
      ],
      "title": "p95 latency",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 4, "unit": "currencyUSD" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "targets": [
        {
          "expr": "sum by (agent) (increase(llm_cost_usd_total[1h]))",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ],
      "title": "Cost per hour by agent",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "targets": [
        {
          "expr": "sum by (model, type) (increase(llm_tokens_total[1h]))",
          "legendFormat": "{{model}} {{type}}",
          "refId": "A"
        }
      ],
      "title": "Tokens per hour",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, agent) (rate(llm_latency_ms_bucket[5m])))",
          "legendFormat": "p50 {{agent}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, agent) (rate(llm_latency_ms_bucket[5m])))",
          "legendFormat": "p95 {{agent}}",
          "refId": "B"
        }
      ],
      "title": "Latency by agent",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 2, "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "targets": [
        {
          "expr": "sum by (agent) (rate(llm_calls_total[5m]))",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ],
      "title": "Call rate by agent",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["firstpass", "llm"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Firstpass LLM usage",
  "uid": "firstpass-llm",
  "version": 1
}
